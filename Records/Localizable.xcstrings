    "The URL or ID format was not recognized. Enter an album or playlist URL.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das URL- oder ID-Format wurde nicht erkannt. Gib die URL eines Albums oder einer Playlist ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se reconoció el formato de la URL o el ID. Introduce la URL de un álbum o playlist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format de l’URL ou de l’ID n’a pas été reconnu. Saisissez l’URL d’un album ou d’une playlist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URLまたはIDの形式を認識できませんでした。アルバムまたはプレイリストのURLを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 또는 ID 형식을 인식할 수 없습니다. 앨범 또는 재생목록 URL을 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别 URL 或 ID 格式。请输入专辑或播放列表的 URL。"
          }
        }
      }
    },
    "The new language will take effect after you restart Records.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Sprache wird nach einem Neustart von Records wirksam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo idioma se aplicará al reiniciar Records."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle langue sera appliquée après le redémarrage de Records."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語はRecordsの再起動後に反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 언어는 Records를 재시작한 후 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新语言将在重新启动 Records 后生效。"
          }
        }
      }
    },
    "The records on this shelf will be removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einträge in diesem Regal werden entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los discos de este estante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les disques de cette étagère seront supprimés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシェルフのレコードが削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 선반의 레코드가 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此唱片架中的唱片将被移除。"
          }
        }
      }
    },
    "The shelf is full. You can add up to %lld records.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Regal ist voll. Du kannst bis zu %lld Einträge hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estantería está llena. Puedes añadir hasta %lld discos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’étagère est pleine. Vous pouvez ajouter jusqu’à %lld disques."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録できるのは%lld枚までです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선반이 가득 찼습니다. 최대 %lld개까지 등록할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "架子已满，最多可添加 %lld 张唱片。"
          }
        }
      }
    },
