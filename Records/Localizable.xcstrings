    "The shelf is full. You can add up to %lld records." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Regal ist voll. Du kannst bis zu %lld Einträge hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La estantería está llena. Puedes añadir hasta %lld discos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’étagère est pleine. Vous pouvez ajouter jusqu’à %lld disques."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登録できるのは%lld枚までです。"
