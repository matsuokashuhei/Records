    "Access to Apple Music is not allowed. Allow Records in System Settings → Privacy & Security → Media & Apple Music." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf Apple Music ist nicht erlaubt. Erlaube Records unter Systemeinstellungen → Datenschutz & Sicherheit → Medien & Apple Music."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se permite el acceso a Apple Music. Permite Records en Ajustes del Sistema → Privacidad y seguridad → Contenido multimedia y Apple Music."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à Apple Music n’est pas autorisé. Autorisez Records dans Réglages Système → Confidentialité et sécurité → Médias et Apple Music."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Musicへのアクセスが許可されていません。システム設定 → プライバシーとセキュリティ → メディアとApple Music で Records を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music 접근이 허용되지 않았습니다. 시스템 설정 → 개인 정보 보호 및 보안 → 미디어 및 Apple Music에서 Records를 허용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未允许访问 Apple Music。请在“系统设置 → 隐私与安全性 → 媒体与 Apple Music”中允许 Records。"
          }
        }
      }
    },
