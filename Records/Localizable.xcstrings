    "(No shortcuts are visible to the shortcuts command.)": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(Der Befehl shortcuts sieht keine Kurzbefehle.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(El comando shortcuts no muestra ningún atajo.)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "(La commande shortcuts ne voit aucun raccourci.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "(shortcutsコマンドからショートカットが1つも見えません)"
